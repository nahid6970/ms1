# Shared interactive Bash configuration for Termux and Ubuntu.

# Detect Termux without relying on commands that are unavailable in Ubuntu.
IS_TERMUX=false
if [[ -r /etc/os-release ]] && grep -qi '^ID=ubuntu$' /etc/os-release; then
    IS_TERMUX=false
elif [[ "${PREFIX:-}" == *"/com.termux/files/usr"* ]] || [[ -n "${TERMUX_VERSION:-}" ]]; then
    IS_TERMUX=true
fi

# History and interactive key bindings.
shopt -s histappend
export HISTSIZE=5000
export HISTFILESIZE=10000
export HISTCONTROL=ignoreboth:erasedups
export HISTIGNORE="ls:ll:cd:cd -:pwd:exit:clear"
if [[ $- == *i* ]]; then
    bind '"\e[A": history-search-backward' 2>/dev/null || true
    bind '"\e[B": history-search-forward' 2>/dev/null || true
fi

# Shared aliases. Prefer eza when installed and retain ordinary ls otherwise.
alias cls='clear'
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first'
    alias la='eza -a --group-directories-first'
    alias ll='eza -l --header --group-directories-first'
    alias lla='eza -la --header --group-directories-first'
    alias tree='eza --tree'
else
    alias ls='ls --color=auto'
    alias la='ls -a --color=auto'
    alias ll='ls -lah --color=auto'
    alias lla='ls -lah --color=auto'
fi
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias c='clear'
alias q='exit'
alias reload='source ~/.bashrc && echo "reloaded"'
alias bashrc='nano ~/.bashrc'
alias myip='curl -s https://ipinfo.io/ip && echo'
alias ports='ss -tulpn'
alias now='date "+%Y-%m-%d %H:%M:%S"'
alias df='df -h'
alias du='du -sh *'
alias free='free -h'
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph --decorate -15'

# The shared os.sh can be reached from either Ubuntu's home or Termux's home.
os() {
    local termux_home="/data/data/com.termux/files/home"
    if [[ -f "$HOME/ms1/termux/os.sh" ]]; then
        bash "$HOME/ms1/termux/os.sh"
    elif [[ -f "$termux_home/ms1/termux/os.sh" ]]; then
        HOME="$termux_home" bash "$termux_home/ms1/termux/os.sh"
    else
        echo "Could not find ms1/termux/os.sh."
        return 1
    fi
}

osu() {
    local termux_home="/data/data/com.termux/files/home"
    if [[ -f "$HOME/ms1/termux/osu.sh" ]]; then
        bash "$HOME/ms1/termux/osu.sh"
    elif [[ -f "$termux_home/ms1/termux/osu.sh" ]]; then
        HOME="$termux_home" bash "$termux_home/ms1/termux/osu.sh"
    else
        echo "Could not find ms1/termux/osu.sh."
        return 1
    fi
}

# Shared helpers.
mkcd() { mkdir -p "$1" && cd "$1"; }
ff() { find . -name "*$1*" 2>/dev/null; }
hf() {
    command -v fzf >/dev/null 2>&1 || { echo "fzf is not installed."; return 1; }
    local selected
    selected=$(history | awk '{$1=""; print substr($0,2)}' | fzf --height=40% --reverse --prompt="Search History: " --ansi)
    [[ -n "$selected" ]] && eval "$selected"
}
hh() {
    [[ -n "$1" ]] || { echo "Usage: hh <pattern>"; return 1; }
    history | grep --color=auto -i "$1"
}
git_clone() {
    local repo_url="$1"
    [[ -n "$repo_url" ]] || { echo "Usage: git_clone <repo-url>"; return 1; }
    local repo_name
    repo_name=$(basename "$repo_url" .git)
    if [[ -d "$repo_name/.git" ]]; then
        (cd "$repo_name" && git pull)
    else
        git clone "$repo_url"
    fi
}

# OS-specific commands and startup behavior.
if [[ "$IS_TERMUX" == true ]]; then
    alias gg='python ~/ms1/tools/terminal_tui/gemini_terminal_cli/gemini_cli.py --password 182358 --max-output-tokens 65536'
    alias osx='bash ~/ms3/osx.sh'
    alias ubuntu='proot-distro login ubuntu'
    alias playwwe='echo "playwwe" && mpv /storage/emulated/0/song/wwe/ww.mp3'
    alias rb='termux-reload-settings'
    alias rc='bash ~/ms3/Remote_Control_rclone/rclone_rmote_control.sh'
    alias rm='rm -f -r'
    alias ro='rclone cat g00:/Remote_Control/output.txt'
    alias update='pkg update && pkg upgrade -y'

    termux-wake-lock 2>/dev/null || true
    if [[ -f /data/data/com.termux/files/usr/etc/bash_completion ]]; then
        . /data/data/com.termux/files/usr/etc/bash_completion
    fi

    SCRIPTS_DIR="$HOME/ms3/scripts"
    if [[ -d "$SCRIPTS_DIR" ]]; then
        for script in "$SCRIPTS_DIR"/*.sh; do
            [[ -r "$script" ]] && . "$script"
        done
    fi
    command -v sshd >/dev/null 2>&1 && sshd 2>/dev/null || true

    nvim() {
        local switch_script="$HOME/ms3/switch_termux_properties.sh"
        if [[ -x "$switch_script" ]]; then "$switch_script" nvim; fi
        command nvim "$@"
        if [[ -x "$switch_script" ]]; then "$switch_script" default; fi
    }
else
    alias update='sudo apt update && sudo apt upgrade -y'
    alias rb='reload'

    _git_branch() {
        git rev-parse --is-inside-work-tree &>/dev/null || return
        local branch
        branch=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)
        printf " \033[0;33m(%s)\033[0m" "$branch"
    }
    PS1='\[\033[0;32m\]\u@\h\[\033[0m\] \[\033[0;34m\]\w\[\033[0m\]$(_git_branch) \[\033[0;36m\]❯\[\033[0m\] '
fi

export PATH="$HOME/bin:$PATH"

# Optional prompt, directory jump, and startup tools.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash --cmd cd)"
fi
if [[ "$IS_TERMUX" == true ]] && command -v oh-my-posh >/dev/null 2>&1; then
    local_omp_config="$HOME/.config/ohmyposh/catppuccin.omp.json"
    if [[ -f "$local_omp_config" ]]; then
        eval "$(oh-my-posh init bash --config "$local_omp_config")"
    fi
fi
if [[ $- == *i* ]] && command -v fastfetch >/dev/null 2>&1; then
    fastfetch
fi
