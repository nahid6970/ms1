{
  "manifest_version": 3,
  "name": "My Script Manager",
  "version": "1.0",
  "description": "A Chrome extension to manage and inject custom scripts.",
  "permissions": [
    "storage",
    "scripting",
    "downloads",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "page_bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "assets/icons/img-128x128.png",
      "48": "assets/icons/img-48x48.png",
      "16": "assets/icons/img-16x16.png"
    }
  },
   "icons": {
      "128": "assets/icons/img-128x128.png",
      "48": "assets/icons/img-48x48.png",
      "16": "assets/icons/img-16x16.png"
   },
   "commands": {
      "reveal-in-explorer": {
         "suggested_key": {
            "default": "Ctrl+Shift+F"
         },
         "description": "Reveal current local file in File Explorer"
      }
   }
}
